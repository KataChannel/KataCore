{
  "name": "tazacore",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.17.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "// ========== DEVELOPMENT ==========": "",
    "dev": "bun --bun next dev -p 3900",
    "dev:debug": "NODE_OPTIONS='--inspect' next dev -p 3900 --turbo",
    "dev:https": "next dev --experimental-https -p 3900",
    "dev:fast": "NEXT_TELEMETRY_DISABLED=1 next dev -p 3900 --turbo",
    "dev:analyze": "ANALYZE=true next dev -p 3900",
    "// ========== BUILD & START ==========": "",
    "build": "bun --bun next build",
    "build:fast": "NEXT_TELEMETRY_DISABLED=1 next build",
    "build:turbo": "next build --experimental-build-worker",
    "build:optimized": "NODE_OPTIONS='--max-old-space-size=4096' NEXT_TELEMETRY_DISABLED=1 next build",
    "build:standalone": "next build",
    "build:analyze": "ANALYZE=true next build",
    "build:production": "NODE_ENV=production next build",
    "build:check": "npm run type-check && npm run lint && npm run build",
    "start": "bun --bun next start -p 3900",
    "start:safe": "rm -rf .next && next build && next start -p 3900",
    "start:fast": "NODE_OPTIONS='--max-old-space-size=2048' NEXT_TELEMETRY_DISABLED=1 next start -p 3900",
    "start:optimized": "NEXT_TELEMETRY_DISABLED=1 NODE_OPTIONS=\"--max-old-space-size=2048\" next start -p 3900",
    "start:turbo": "next start --turbo -p 3900",
    "start:prod": "NODE_ENV=production next start -p 3900",
    "start:standalone": "node .next/standalone/server.js",
    "start:port": "next start -p",
    "start:benchmark": "time NODE_OPTIONS='--max-old-space-size=2048' NEXT_TELEMETRY_DISABLED=1 next start",
    "start:pwa": "NEXT_TELEMETRY_DISABLED=1 NODE_OPTIONS='--max-old-space-size=2048' next start",
    "// ========== TESTING ==========": "",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:coverage:open": "jest --coverage && open coverage/lcov-report/index.html",
    "test:unit": "jest --testPathPattern=src/.*\\.test\\.(ts|tsx)$",
    "test:integration": "jest --testPathPattern=src/.*\\.integration\\.(ts|tsx)$",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "// ========== LINTING & FORMATTING ==========": "",
    "lint": "bun --bun next lint",
    "lint:fix": "eslint . --fix",
    "lint:strict": "next lint --max-warnings 0",
    "lint:report": "next lint --format html --output-file eslint-report.html",
    "format": "prettier --write .",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "format:fix": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "type-check": "bun --bun tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "// ========== DATABASE ==========": "",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed/unified-comprehensive-seed.ts",
    "db:seed:master": "tsx prisma/seed/master-seed.ts",
    "db:seed:unified": "tsx prisma/seed/unified-comprehensive-seed.ts",
    "db:backup": "tsx prisma/backup.ts",
    "db:restore": "tsx prisma/restore.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "db:pull": "prisma db pull",
    "db:format": "prisma format",
    "// ========== ADMIN TOOLS ==========": "",
    "admin:create": "tsx scripts/quick-create-admin.ts",
    "admin:create-interactive": "tsx scripts/create-admin-user.ts",
    "admin:super": "tsx scripts/create-super-admin.ts",
    "admin:cli": "node scripts/super-admin-cli.js",
    "admin:list": "node scripts/super-admin-cli.js list",
    "admin:check": "node scripts/super-admin-cli.js check",
    "// ========== UTILITIES ==========": "",
    "clean": "rm -rf .next out dist node_modules/.cache",
    "clean:all": "rm -rf .next node_modules .turbo tsconfig.tsbuildinfo",
    "clean:cache": "rm -rf .next/cache node_modules/.cache",
    "// ========== SECURITY & MONITORING ==========": "",
    "audit": "npm audit",
    "audit:fix": "npm audit fix",
    "security:scan": "npm audit --audit-level moderate",
    "health": "curl -f http://localhost:3000/api/health || echo 'Site not healthy'",
    "sitemap": "next-sitemap",
    "// ========== DEPLOYMENT ==========": "",
    "export": "next export",
    "deploy:vercel": "vercel --prod",
    "deploy:netlify": "netlify deploy --prod",
    "// ========== WORKFLOW ==========": "",
    "precommit": "npm run lint:fix && npm run format && npm run type-check",
    "prebuild": "if [ \"$DOCKER_BUILD\" != \"true\" ]; then bun run db:generate; fi",
    "analyze": "ANALYZE=true next build",
    "ci": "npm run lint && npm run type-check && npm run test:ci && npm run build",
    "dev:full": "npm run db:generate && npm run dev",
    "fresh": "npm run clean:all && npm install && npm run db:generate && npm run dev",
    "// ========== FACEBOOK SETUP ==========": "",
    "facebook:check": "node scripts/check-facebook-setup.js",
    "facebook:test": "echo 'Testing Facebook Login - Please check browser console'",
    "dev:turbo": "bun --bun next dev --turbo -p 3900",
    "clean:install": "rm -rf node_modules bun.lockb && bun install"
  },
  "dependencies": {
    "@apollo/client": "^3.13.9",
    "@apollo/server": "^5.0.0",
    "@graphql-tools/schema": "^10.0.25",
    "@heroicons/react": "^2.2.0",
    "@prisma/client": "^6.11.1",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/papaparse": "^5.3.16",
    "autoprefixer": "10.4.20",
    "axios": "^1.10.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "critters": "^0.0.25",
    "dataloader": "^2.2.3",
    "date-fns": "^4.1.0",
    "eslint": "^9.32.0",
    "graphql": "^16.11.0",
    "graphql-fields": "^2.0.3",
    "graphql-request": "^7.2.0",
    "graphql-scalars": "^1.24.2",
    "graphql-yoga": "^5.15.1",
    "jsonwebtoken": "^9.0.2",
    "jssip": "^3.10.1",
    "jwks-rsa": "^3.2.0",
    "lucide-react": "^0.517.0",
    "nanoid": "^5.1.5",
    "next": "latest",
    "next-auth": "5.0.0-beta.25",
    "next-pwa": "^5.6.0",
    "nexus": "^1.3.0",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "papaparse": "^5.5.3",
    "postcss": "^8.5.1",
    "postgres": "^3.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.1",
    "typescript": "5.7.3",
    "use-debounce": "^10.0.4",
    "xlsx": "^0.18.5",
    "zod": "^3.25.17"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/graphql-fields": "^1.3.9",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/lodash": "^4.17.18",
    "@types/minimatch": "^5.1.2",
    "@types/node": "^22.16.3",
    "@types/node-fetch": "^2.6.12",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/xlsx": "^0.0.36",
    "dotenv": "^17.2.1",
    "eslint-config-next": "^15.4.6",
    "prettier": "^3.6.2",
    "sharp": "^0.34.2",
    "tailwindcss": "^4.1.11",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3"
  }
}
