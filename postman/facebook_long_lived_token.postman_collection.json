  "item": [
    {
      "name": "🔐 Authentication",
      "description": "Facebook OAuth authentication flow",
      "item": [
        {
          "name": "Get Short-Lived User Access Token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://www.facebook.com/v19.0/dialog/oauth?client_id={{APP_ID}}&redirect_uri={{REDIRECT_URI}}&scope={{SCOPE}}&response_type=token",
              "protocol": "https",
              "host": ["www", "facebook", "com"],
              "path": ["v19.0", "dialog", "oauth"],
              "query": [
                {
                  "key": "client_id",
                  "value": "{{APP_ID}}",
                  "description": "Your Facebook App ID"
                },
                {
                  "key": "redirect_uri",
                  "value": "{{REDIRECT_URI}}",
                  "description": "Your app's redirect URI (e.g., https://your-app.com/callback)"
                },
                {
                  "key": "scope",
                  "value": "{{SCOPE}}",
                  "description": "Comma-separated permissions (e.g., pages_show_list,pages_read_engagement,pages_manage_posts)"
                },
                {
                  "key": "response_type",
                  "value": "token",
                  "description": "Set to 'token' for client-side flow"
                }
              ]
            },
            "description": "Open this URL in a browser, log in, and extract the short-lived access token from the redirect URL (in the access_token parameter). Then, store it in the SHORT_LIVED_TOKEN variable."
          },
          "response": []
        },
        {
          "name": "Exchange Short-Lived Token for Long-Lived Token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://graph.facebook.com/v19.0/oauth/access_token?grant_type=fb_exchange_token&client_id={{APP_ID}}&client_secret={{APP_SECRET}}&fb_exchange_token={{SHORT_LIVED_TOKEN}}",
              "protocol": "https",
              "host": ["graph", "facebook", "com"],
              "path": ["v19.0", "oauth", "access_token"],
              "query": [
                {
                  "key": "grant_type",
                  "value": "fb_exchange_token"
                },
                {
                  "key": "client_id",
                  "value": "{{APP_ID}}",
                  "description": "Your Facebook App ID"
                },
                {
                  "key": "client_secret",
                  "value": "{{APP_SECRET}}",
                  "description": "Your Facebook App Secret"
                },
                {
                  "key": "fb_exchange_token",
                  "value": "{{SHORT_LIVED_TOKEN}}",
                  "description": "Short-lived token from the previous step"
                }
              ]
            },
            "description": "Exchanges a short-lived user access token for a long-lived one (valid for ~60 days)."
          },
          "response": []
        },
        {
          "name": "Get User ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://graph.facebook.com/v23.0/me?access_token={{LONG_LIVED_TOKEN}}&fields=id",
              "protocol": "https",
              "host": ["graph", "facebook", "com"],
              "path": ["v23.0", "me"],
              "query": [
                {
                  "key": "access_token",
                  "value": "{{LONG_LIVED_TOKEN}}",
                  "description": "Long-lived user access token from the previous step"
                },
                {
                  "key": "fields",
                  "value": "id",
                  "description": "Fields to retrieve"
                }
              ]
            },
            "description": "Fetches the user ID for use in the next step to get page access tokens. Store the 'id' from the response in the USER_ID variable."
          },
          "response": []
        },
        {
          "name": "Get Page Access Token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://graph.facebook.com/v23.0/{{USER_ID}}/accounts?access_token={{LONG_LIVED_TOKEN}}&fields=id,name,category,fan_count,followers_count,link,about,phone,website,access_token",
              "protocol": "https",
              "host": ["graph", "facebook", "com"],
              "path": ["v23.0", "{{USER_ID}}", "accounts"],
              "query": [
                {
                  "key": "access_token",
                  "value": "{{LONG_LIVED_TOKEN}}",
                  "description": "Long-lived user access token"
                },
                {
                  "key": "fields",
                  "value": "id,name,category,fan_count,followers_count,link,about,phone,website,access_token",
                  "description": "Page fields to retrieve"
                }
              ]
            },
            "description": "Fetches page access tokens for all pages the user manages. These tokens typically never expire unless permissions are revoked."
          },
          "response": []
        }
      ]
    },
